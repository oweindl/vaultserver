# Kopieren nach .env (nicht ins Repo) und anpassen. Je Kunde eine eigene .env (docker compose -p <kunde>).
UID=1000
GID=1000
VS_PORT=8100
# Erscheint in der Commit-Adresse vaultserver@<hostname>, falls [git] committer nicht gesetzt ist
VS_HOSTNAME=vaultserver
VS_CONFIG=./vaultserver.toml
VS_DATA=./data
# Ordner für den Vault. Leer lassen + [git] url in der toml = VaultServer klont beim ersten Start.
VS_VAULT=./vault
# Optional: ein Code-Repo für Commit-Verknüpfungen (nur lesend)
VS_CODE_REPO=./data/empty
# Token für das Vault-Repo aus [git] url, nur Lesen/Schreiben von Inhalten auf genau diesem Repo
# (GitHub: fine-grained, Contents read/write; GitLab: Projekt-Token mit write_repository).
VS_GIT_TOKEN=
