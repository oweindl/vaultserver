# Kopieren nach .env (nicht im Repo) und anpassen.
UID=1000
GID=1000
VS_PORT=8100
VS_HOSTNAME=webtest
VS_CONFIG=./vaultserver.toml
VS_DATA=./data
VS_VAULT=/home/oweindl/obsidian-oweindl
VS_CODE_REPO=/home/oweindl/pdfcloud-pro
# Fine-grained GitHub-Token, nur Contents read/write auf oweindl/obsidian-oweindl.
# Leer lassen, wenn der Vault-Remote anders erreichbar ist.
GIT_TOKEN=
